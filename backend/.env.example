# Backend settings (prefix ARQHUB_). Copy to .env for local overrides.
# Dev default is SQLite (zero infra). For Postgres:
# ARQHUB_DATABASE_URL=postgresql+psycopg://arqhub:arqhub@localhost:5432/arqhub
ARQHUB_DATABASE_URL=sqlite+pysqlite:///./arqhub.db

# Dev auth stub authenticates every request as the seed admin. NEVER true in prod.
ARQHUB_DEV_AUTH=true

# Entra ID (Azure AD) OIDC — required when ARQHUB_DEV_AUTH=false.
# ARQHUB_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ARQHUB_ENTRA_CLIENT_ID=api://arqhub          # token audience
# issuer/jwks are derived from tenant id, or override explicitly:
# ARQHUB_ENTRA_ISSUER=https://login.microsoftonline.com/<tid>/v2.0
# ARQHUB_ENTRA_JWKS_URI=https://login.microsoftonline.com/<tid>/discovery/v2.0/keys
# Map an Entra app-role name or group object id -> ArqHub role (JSON):
# ARQHUB_ENTRA_ROLE_MAP={"<group-guid>":"editor"}
# ARQHUB_DEFAULT_ROLE=viewer

ARQHUB_DEFAULT_TENANT_SLUG=demo
ARQHUB_DEFAULT_TENANT_NAME=Demo Org

# Redis for the arq job worker (daily model snapshots, exports, notifications).
ARQHUB_REDIS_URL=redis://localhost:6379
