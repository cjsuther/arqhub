# Copy to .env to override docker compose defaults (used by docker-compose.yml).
# The .env file is gitignored — do not commit real secrets.

# --- PostgreSQL ---
POSTGRES_USER=arqhub
POSTGRES_PASSWORD=arqhub
POSTGRES_DB=arqhub
POSTGRES_PORT=5432

# --- API ---
# true  = dev auth stub (everyone is the seed admin) — for local/demo only.
# false = require real Entra ID OIDC bearer tokens (set ARQHUB_ENTRA_* too).
ARQHUB_DEV_AUTH=true
