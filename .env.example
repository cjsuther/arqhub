# Copy to .env to override docker compose defaults (used by docker-compose.yml).
# The .env file is gitignored — do not commit real secrets.

# --- PostgreSQL ---
POSTGRES_USER=arqhub
# CHANGE THIS before any non-local deployment.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arqhub

# --- Redis ---
# Redis requires a password (auth). CHANGE THIS before any non-local deployment.
REDIS_PASSWORD=change-me

# --- API auth ---
# Secure by default: the API requires real Entra ID OIDC bearer tokens.
# To run the OPEN demo where every request is the seed admin (NO login), set BOTH:
#   ARQHUB_DEV_AUTH=true
#   ARQHUB_ALLOW_INSECURE_DEV_AUTH=true   # required because the demo uses Postgres
# Never do this on a network anyone else can reach.
ARQHUB_DEV_AUTH=false
ARQHUB_ALLOW_INSECURE_DEV_AUTH=false

# For real auth (dev_auth=false) configure Entra ID on the api service:
#   ARQHUB_ENTRA_TENANT_ID=...
#   ARQHUB_ENTRA_CLIENT_ID=...
